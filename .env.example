# ==========================================
# RouteRescue Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
PORT=8000
FRONTEND_PORT=3000

# API Settings
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Planned PostgreSQL / Local SQLite fallback)
DATABASE_URL=sqlite:///./routerescue.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/routerescue

# AI Provider Settings (Optional / Planned LLM Integration)
# LLM is used for natural language explanation and constraint parsing, NOT deterministic checks
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2

# Logging & Debugging
LOG_LEVEL=INFO
